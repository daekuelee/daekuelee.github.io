---
import type { CollectionKey } from '@lib/content';
import { collectionLabel, entryHref } from '@lib/content';
import { formatDate } from '@lib/site';
import TagList from './TagList.astro';

interface Props {
  entry: any;
  collection: CollectionKey;
}

const { entry, collection } = Astro.props;
const href = entryHref(collection, entry.id);
---

<article class="entry-card">
  <div class="entry-card__meta">
    <span>{collectionLabel(collection)}</span>
    <span>{entry.data.lang.toUpperCase()}</span>
    <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
  </div>
  <h2><a href={href}>{entry.data.title}</a></h2>
  <p>{entry.data.description}</p>
  <TagList tags={entry.data.tags} />
</article>
