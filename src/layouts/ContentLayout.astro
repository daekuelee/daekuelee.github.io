---
import TagList from '@components/TagList.astro';
import { seriesHref } from '@lib/content';
import { formatDate } from '@lib/site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="content-page">
    <header class="content-header">
      <div class="entry-card__meta">
        <span>{entry.data.lang.toUpperCase()}</span>
        <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
        {
          entry.data.updatedDate && (
            <span>Updated {formatDate(entry.data.updatedDate)}</span>
          )
        }
      </div>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.description}</p>
      {entry.data.series && <a class="series-link" href={seriesHref(entry.data.series)}>Series: {entry.data.series}</a>}
      <TagList tags={entry.data.tags} />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
